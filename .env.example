# MySQL 8 application database (URL-encode special characters in credentials).
DATABASE_URL=mysql://treasure_app:change-me@127.0.0.1:3306/treasure_company
MYSQL_POOL_SIZE=10
# Optional PEM certificate content for a remote TLS connection.
# MYSQL_SSL_CA=

# Optional real AI generation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Local startup reuses data/integration-master.key to decrypt saved connections.
# Configure PLATFORM_MASTER_KEY explicitly on a remote Node deployment.
# PLATFORM_MASTER_KEY=
