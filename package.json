{
  "name": "treasure-company",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev --port 3003",
    "build": "node scripts/build-info.mjs && vinext build",
    "start": "node scripts/start-local.mjs --no-open",
    "db:local": "node scripts/mysql-migrate.mjs",
    "db:dev": "node scripts/mysql-migrate.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:platform": "node tests/platform.integration.mjs",
    "test:portrait": "node --experimental-strip-types --import ./tests/register-types.mjs tests/enterprise-portrait.test.mjs",
    "test:portrait:api": "node --experimental-strip-types tests/enterprise-portrait.integration.mjs",
    "test:agents": "node tests/agents.integration.mjs",
    "test:modules": "node --experimental-strip-types --import ./tests/register-types.mjs tests/platform-modules.integration.mjs",
    "db:migrate": "node scripts/mysql-migrate.mjs",
    "db:import": "node scripts/mysql-import.mjs",
    "test:mysql": "node --experimental-strip-types tests/mysql.integration.mjs",
    "pretypecheck": "node scripts/build-info.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.75",
    "@ai-sdk/openai": "^4.0.104",
    "@base-ui/react": "1.7.0",
    "@langchain/langgraph": "^1.5.3",
    "@shadcn/react": "0.3.0",
    "ai": "^7.0.155",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "exceljs": "^4.4.0",
    "input-otp": "1.4.2",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "mysql2": "^3.24.6",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-force-graph-2d": "^1.29.2",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
